<idea-plugin>
    <id>com.tracklm.tokitoki.jetbrains</id>
    <name>TokiToki</name>
    <vendor email="support@tracklm.local" url="https://github.com/labx/tokitoki-agent">TrackLM</vendor>

    <description><![CDATA[
      JetBrains IDE integration for the local TokiToki usage sync agent.
      The plugin shells out to the local <code>tokitoki</code> CLI to sync local AI coding usage.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.tracklm.tokitoki.jetbrains.TokitokiStartupActivity"/>
        <projectService serviceImplementation="com.tracklm.tokitoki.jetbrains.TokitokiProjectService"/>
        <applicationService serviceImplementation="com.tracklm.tokitoki.jetbrains.settings.TokitokiSettings"/>
        <applicationConfigurable
            instance="com.tracklm.tokitoki.jetbrains.settings.TokitokiConfigurable"
            id="tokitoki.settings"
            displayName="TokiToki"/>
        <notificationGroup id="TokiToki" displayType="BALLOON"/>
    </extensions>

    <actions>
        <group id="Tokitoki.Menu" text="TokiToki" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="Tokitoki.SyncNow"
                    class="com.tracklm.tokitoki.jetbrains.actions.SyncNowAction"
                    text="Sync Now"
                    description="Run the local TokiToki CLI once"/>
            <action id="Tokitoki.SetApiKey"
                    class="com.tracklm.tokitoki.jetbrains.actions.SetApiKeyAction"
                    text="Set API Key"
                    description="Save the TokiToki API key through the local CLI"/>
            <action id="Tokitoki.ShowApiKeyStatus"
                    class="com.tracklm.tokitoki.jetbrains.actions.ShowApiKeyStatusAction"
                    text="Show API Key Status"
                    description="Read the configured TokiToki API key status"/>
            <separator/>
            <action id="Tokitoki.ServiceInstall"
                    class="com.tracklm.tokitoki.jetbrains.actions.ServiceInstallAction"
                    text="Install Background Service"/>
            <action id="Tokitoki.ServiceStart"
                    class="com.tracklm.tokitoki.jetbrains.actions.ServiceStartAction"
                    text="Start Background Service"/>
            <action id="Tokitoki.ServiceStop"
                    class="com.tracklm.tokitoki.jetbrains.actions.ServiceStopAction"
                    text="Stop Background Service"/>
            <action id="Tokitoki.ServiceRestart"
                    class="com.tracklm.tokitoki.jetbrains.actions.ServiceRestartAction"
                    text="Restart Background Service"/>
            <action id="Tokitoki.ServiceStatus"
                    class="com.tracklm.tokitoki.jetbrains.actions.ServiceStatusAction"
                    text="Show Background Service Status"/>
        </group>
    </actions>
</idea-plugin>
